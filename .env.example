# Copy to .env.local for app credentials; the Agent writes the storefront access password to ignored .env. Never commit either file.
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_API_VERSION=2025-10
SHOPIFY_STOREFRONT_URL=https://your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_PASSWORD=
SHOPIFY_THEME_ID=
